{
  "prefix": "#",
  "commands": [
    {
      "name": "goto",
      "usage": "#goto <x> <y> <z> | #goto <place>",
      "description": "Walk to a position or a saved place.",
      "args": [
        {
          "name": "target",
          "type": "position"
        }
      ],
      "skill": "goto.js",
      "keywords": [
        "go",
        "walk",
        "come",
        "head",
        "travel",
        "move"
      ]
    },
    {
