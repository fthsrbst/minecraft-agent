      "usage": "#mine <block> [count]",
      "description": "Mine and pick up blocks of a kind that are in sight.",
      "args": [
        {
          "name": "block",
          "type": "word"
        },
        {
          "name": "count",
          "type": "int",
          "default": 1,
          "min": 1,
          "max": 64
        }
      ],
      "skill": "mine.js",
      "keywords": [
        "dig",
        "collect",
        "gather",
        "get",
        "chop"
      ]
    },
    {
      "name": "follow",
      "usage": "#follow [player] [seconds]",
      "description": "Follow a player (the sender by default) for a while.",
      "args": [
        {
          "name": "player",
          "type": "player",
          "default": "$sender"
        },
        {
          "name": "seconds",
          "type": "int",
          "default": 120,
          "min": 5,
          "max": 600
        }
      ],
      "skill": "follow.js",
      "keywords": [
        "follow",
        "with me",
        "come along",
        "after me"
      ]
    },
    {
      "name": "stop",
      "usage": "#stop",
      "description": "Stop whatever the bot is doing.",
      "args": [],
