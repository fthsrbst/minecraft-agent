{
  "name": "@minecraft-agent/plugin-minecraft",
  "version": "0.1.0",
  "description": "Minecraft game plugin: runs as a separate process and talks to the core over JSON-RPC.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "hello": "npm run build && node --env-file-if-exists=../../.env dist/hello-bot.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "mineflayer": "4.39.0"
  }
}
